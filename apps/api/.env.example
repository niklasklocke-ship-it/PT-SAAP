DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pt_saas?schema=public"
JWT_SECRET="change-me-in-production"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PORT=3001

# Google Calendar OAuth (siehe README für Setup-Schritte in der Google Cloud
# Console). Ohne diese Variablen bleibt "Google Calendar verbinden" inaktiv.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/google-calendar/callback"
FRONTEND_URL="http://localhost:3000"

# SMTP für den Passwort-Reset-Mailversand. Ohne diese Variablen wird der
# Reset-Link stattdessen nur ins Server-Log geschrieben (nützlich fürs
# lokale Testen ohne echten Mail-Provider).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PT One <no-reply@pt-one.app>"

# PayPal-Abo für die eigene PT-One-Subscription des Trainers (siehe
# billing/). PAYPAL_WEBHOOK_ID kommt erst nach dem Registrieren der
# Webhook-URL im PayPal-Dashboard - braucht dafür eine öffentlich
# erreichbare HTTPS-Adresse dieser API (lokal z.B. per ngrok-Tunnel).
# Ohne diese Variablen bleibt "Mit PayPal bezahlen" inaktiv.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PLAN_ID_PRO_MONTHLY=""
API_URL="http://localhost:3001"
