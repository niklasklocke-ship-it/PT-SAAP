generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ein Tenant = ein Personal Trainer (Kunde des SaaS-Produkts)
model Tenant {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  taxId            String?
  subscriptionPlan String   @default("trial")
  publicApiKey     String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customers    Customer[]
  services     Service[]
  appointments Appointment[]
  invoices     Invoice[]

  @@map("tenants")
}

// Kunde eines Trainers (Trainingsklient)
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  // Trainingsziele: kurze Übersicht (z.B. in der Kundenliste) + optionales
  // Detailfeld für eine ausführlichere Beschreibung. Trainingsplan als
  // einfaches Freitextfeld ("was soll trainiert werden") - der tatsächliche
  // Fortschritt/die Gewichte werden strukturiert in ExerciseLog erfasst.
  trainingGoalsSummary String?
  trainingGoalsDetail  String?
  trainingPlan         String?

  appointments Appointment[]
  packages     CustomerPackage[]
  invoices     Invoice[]
  exerciseLogs ExerciseLog[]
  trainingPlanTree TrainingPlan?

  @@index([tenantId])
  @@map("customers")
}

// Ein einzelner geloggter Trainingssatz/-eintrag für eine Übung, z.B.
// "Bankdrücken, 60kg, 3x8, 2026-07-28" - Grundlage für den
// Fortschritts-/Gewichtsverlauf pro Übung im Kundendetail.
// category (z.B. "Push"/"Pull"/"Legs") ist freier Text, nicht enum - der
// Trainer legt eigene Kategorien fest. Wird genutzt, um im Frontend die
// Übungsvorschläge auf frühere Einträge derselben Kategorie einzugrenzen.
model ExerciseLog {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  category     String?
  exerciseName String
  weight       Decimal? @db.Decimal(6, 2)
  sets         Int?
  reps         Int?
  performedAt  DateTime
  notes        String?
  createdAt    DateTime @default(now())

  @@index([customerId, exerciseName])
  @@map("exercise_logs")
}

// Strukturierter Trainingsplan (Baumstruktur, ersetzt den alten Freitext-
// Ansatz): ein Plan pro Kunde, mehrere Trainingstage, jeder Tag mehrere
// Abschnitte (Kategorie z.B. Push/Pull/Beine), jeder Abschnitt mehrere
// Übungen mit Sätzen/Wdh/Gewicht/Pause/Notizen. order jeweils für
// Drag-and-Drop-Reihenfolge innerhalb der Elternebene.
model TrainingPlan {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days TrainingDay[]

  @@map("training_plans")
}

model TrainingDay {
  id        String       @id @default(uuid())
  planId    String
  plan      TrainingPlan @relation(fields: [planId], references: [id])
  name      String
  order     Int

  sections TrainingSection[]

  @@index([planId])
  @@map("training_days")
}

model TrainingSection {
  id       String      @id @default(uuid())
  dayId    String
  day      TrainingDay @relation(fields: [dayId], references: [id])
  category String
  order    Int

  exercises TrainingExercise[]

  @@index([dayId])
  @@map("training_sections")
}

model TrainingExercise {
  id          String          @id @default(uuid())
  sectionId   String
  section     TrainingSection @relation(fields: [sectionId], references: [id])
  name        String
  sets        Int?
  reps        Int?
  weight      Decimal?        @db.Decimal(6, 2)
  restSeconds Int?
  notes       String?
  order       Int

  @@index([sectionId])
  @@map("training_exercises")
}

enum ServiceType {
  SINGLE
  PACKAGE
  SUBSCRIPTION
}

// Leistung/Angebot eines Trainers (Einzelstunde, 10er-Karte, Abo)
model Service {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  name        String
  price       Decimal     @db.Decimal(10, 2)
  durationMin Int
  type        ServiceType @default(SINGLE)
  createdAt   DateTime    @default(now())

  appointments Appointment[]
  packages     CustomerPackage[]

  @@index([tenantId])
  @@map("services")
}

// Gekauftes Paket/Abo eines Kunden - trennt "gekauft" von "gebucht"
model CustomerPackage {
  id                String    @id @default(uuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  serviceId         String
  service           Service   @relation(fields: [serviceId], references: [id])
  remainingSessions Int
  validUntil        DateTime?
  createdAt         DateTime  @default(now())

  @@index([customerId])
  @@map("customer_packages")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  serviceId  String
  service    Service           @relation(fields: [serviceId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus @default(BOOKED)
  createdAt  DateTime          @default(now())

  invoice Invoice?

  @@index([tenantId, startTime])
  @@map("appointments")
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  invoiceNumber String
  amount        Decimal       @db.Decimal(10, 2)
  taxRate       Decimal       @db.Decimal(5, 2) @default(0)
  status        InvoiceStatus @default(OPEN)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?

  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@map("invoices")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(uuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id])
  provider              String
  providerTransactionId String?
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}
